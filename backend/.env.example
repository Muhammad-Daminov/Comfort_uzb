# COMFORT UZB — environment variables.
#
# Copy to `.env` (chmod 600, owner `comfort` in production — §12.1) and
# fill in real values. THIS FILE MUST NEVER CONTAIN A REAL SECRET: every
# value below is a placeholder. A real BotFather token was once committed
# here and had to be treated as disclosed — if you paste a live value into
# this file, it is leaked, not configured.
#
# `app/config.py` and `bot/config.py` fail loudly at startup if a required
# variable is missing — there is no silent fallback for anything
# security-sensitive. See docs/09_DEPLOYMENT.md for the full deployment
# procedure this file is one step of.
#
# Every variable below records WHO READS IT, so nothing here is
# cargo-culted into an environment that does not need it.

# ---------------------------------------------------------------------------
# SECRETS — never share, never commit a real value, rotate if leaked.
# ---------------------------------------------------------------------------

# Read by: app/config.py (required), bot/config.py (required).
# The application connects as comfort_app (SELECT/INSERT/UPDATE only, no
# DELETE, no DDL — §12.2). asyncpg DSN, plain `postgresql://` (NOT
# `+psycopg` — that variant is for Alembic only, see the migration section
# at the bottom). Unix socket in production (ADR-1/§13.3); TCP is fine for
# local dev. Carries comfort_app's password, so this whole line is secret.
DATABASE_URL=postgresql://comfort_app:CHANGE_ME@/comfort_uzb?host=/var/run/postgresql

# Read by: app/config.py (required), bot/config.py (required),
# deploy/scripts/health.sh (to send the disk-usage alert).
# From @BotFather. Test bot (separate token) in development, real bot only
# in production — dev and prod must never share a bot, same as they never
# share a database (§17.1). This value also derives the key that verifies
# every Mini App `initData` HMAC (ADR-2), so disclosing it breaks
# authentication for the whole application, not just bot messaging.
BOT_TOKEN=CHANGE_ME_bot_token_from_botfather

# Read by: app/config.py (required).
# HMAC-signs POST /auth/session tokens (app/security/session.py). Generate
# with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=CHANGE_ME_random_secret

# Read by: app/config.py (required).
# Signs product/receipt file URLs (ADR-13). Must match Nginx's
# `secure_link_md5` secret byte-for-byte — see docs/09_DEPLOYMENT.md
# "Signed URLs". Generate the same way as SESSION_SECRET.
SIGNING_SECRET=CHANGE_ME_random_secret

# Read by: bot/config.py (required).
# Validates the `X-Telegram-Bot-Api-Secret-Token` header on incoming
# webhook calls (bot/main.py) — proves a request genuinely came from
# Telegram's servers, not an arbitrary caller who guessed the webhook path.
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_random_secret

# ---------------------------------------------------------------------------
# PUBLIC CONFIGURATION — not secret, but still explicit per environment.
# ---------------------------------------------------------------------------

# Read by: alembic/versions/0002_owner_bootstrap.py (at migration time),
# deploy/scripts/health.sh (as the alert recipient's chat_id).
# Telegram numeric user id of the single OWNER (ADR-11). Read only once, by
# migration 0002, at the first `alembic upgrade head` — changing it
# afterward does nothing (the OWNER row already exists by then). Not a
# secret, but it is a real person's account id: keep the placeholder here
# and set the real value only in the deployed `.env`.
OWNER_TELEGRAM_ID=000000000

# Read by: bot/config.py (required).
# The Mini App's public HTTPS URL — set as the bot's Menu Button target
# (bot/main.py::configure_bot) and used by the bot to build "open app"
# links. Telegram requires HTTPS; a self-signed certificate will not work.
MINIAPP_URL=https://comfort.example.uz/

# Read by: app/config.py (optional — defaults to /var/comfort/uploads).
# Where uploaded product images and payment receipts are written
# (app/security/uploads.py). Must be a writable, persistent directory that
# survives application restarts and deploys — never a path inside the
# application's own checkout. Default matches ADR-14's documented layout.
UPLOADS_ROOT=/var/comfort/uploads

# Read by: app/cors.py (optional — empty means no CORS grant at all).
# Comma-separated list of origins allowed to make cross-origin requests.
# Leave EMPTY for the primary deployment model (Nginx serves the Mini App
# and the API from the same origin, so no grant is needed). Only set this
# if the Mini App is genuinely hosted on a different origin than the API.
# Never use `*` — see docs/08_SECURITY.md "CORS".
ALLOWED_ORIGINS=

# Read by: app/observability.py (optional — defaults to INFO).
# Python's `logging` level for the structured JSON logs.
# INFO in production; DEBUG locally if you need per-request detail.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PAYMENT PROVIDER — read by app/config.py, app/domains/payments/providers/*.
# ---------------------------------------------------------------------------

# "manual_receipt" (default, active today — admin reviews an uploaded
# receipt image) or "hamyon". Setting "hamyon" without the four HAMYON_*
# variables below fails startup on purpose: no Hamyon API is documented in
# this codebase (docs/13_V2_REBUILD_AUDIT.md §2), so the adapter's methods
# are stubs until a real integration is verified against real docs.
PAYMENT_PROVIDER=manual_receipt

# Required only if PAYMENT_PROVIDER=hamyon. Values are placeholders — no
# capability behind them is implemented yet; see docs/13_V2_REBUILD_AUDIT.md §2.
HAMYON_API_URL=
HAMYON_API_KEY=
HAMYON_MERCHANT_ID=
HAMYON_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI ADMIN ASSISTANT — read by app/config.py, app/ai/*. Optional: leave both
# AI_PROVIDER and STT_PROVIDER empty to run with the deterministic stub
# providers (no live model calls; ADMIN/OWNER-only AI features return
# "unverified — no live provider connected" instead of a real answer).
# ---------------------------------------------------------------------------

# "anthropic", "gemini", or empty. Server-side only — never sent to the
# Mini App/bot client.
AI_PROVIDER=
# Required only if AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required only if AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Optional. Defaults to app/ai/providers/gemini_provider.py's _DEFAULT_MODEL
# when empty. Verify the model name against Google's currently published
# Gemini model list before changing this — never guessed by the app itself.
GEMINI_MODEL=

# Max accepted voice-command audio size in bytes, read by app/ai/audio.py
# via app/config.py. Optional — defaults to
# app/ai/audio.py's DEFAULT_MAX_VOICE_BYTES (1,000,000 — see that file's
# comment for the reasoning) when empty.
AI_VOICE_MAX_BYTES=

# "openai_whisper" or empty.
STT_PROVIDER=
# Required only if STT_PROVIDER=openai_whisper. May be the same key as
# ANTHROPIC_API_KEY's provider is unrelated — OpenAI and Anthropic are
# separate accounts/keys.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# MIGRATION-ONLY — NOT read by the running application. Used only by
# deploy/scripts/deploy.sh, which exports it as DATABASE_URL for the single
# `alembic upgrade head` step (§17.4). Never put this in the application's
# own running .env — it grants DDL.
# ---------------------------------------------------------------------------

# comfort_migrate's DSN, psycopg format (Alembic's engine, not the app's
# asyncpg pool — see alembic/env.py's own docstring for why the URL scheme
# differs from DATABASE_URL above despite the similar name). Secret: it
# carries comfort_migrate's password.
# MIGRATION_DATABASE_URL=postgresql+psycopg://comfort_migrate:CHANGE_ME@/comfort_uzb?host=/var/run/postgresql

# ---------------------------------------------------------------------------
# BACKUP / HEALTH TIMERS — read by deploy/scripts/backup.sh and health.sh
# (systemd units comfort-backup / comfort-health share this EnvironmentFile).
# Not read by the application. Missing DATABASE_NAME makes backup.sh exit 1
# on purpose ("refusing to guess which database to dump"), which before this
# section existed also aborted deploy.sh at its pre-migration backup step.
# ---------------------------------------------------------------------------

# Name of the database to dump nightly.
DATABASE_NAME=comfort_uzb

# comfort_backup's password (secret). pg_dump connects with password auth
# even over the unix socket, so pg_hba.conf must allow scram-sha-256 for
# local connections by this role.
COMFORT_BACKUP_PASSWORD=CHANGE_ME

# Optional. Socket directory (default) or a host for pg_dump/pg_restore.
DATABASE_HOST=/var/run/postgresql

# Optional. Where dumps and upload archives are written (default below).
BACKUP_ROOT=/var/comfort/backup

# Optional. rclone remote for the off-server copy (§17.3 Layer 1). Leave
# empty until R2/equivalent is provisioned — backup.sh warns loudly.
RCLONE_REMOTE=
