[Unit]
Description=COMFORT UZB — daily database + uploads backup (§17.3)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=comfort
Group=comfort
EnvironmentFile=/etc/comfort/backend.env
ExecStart=/opt/comfort/deploy/scripts/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=comfort-backup
